.profile { display:flex; align-items:center; background:#fff1df; }.avatar { display:flex; align-items:center; justify-content:center; width:120rpx; height:120rpx; margin-right:24rpx; border:3rpx solid #473d37; border-radius:50%; background:#fff; font-size:54rpx; }.profile-body { flex:1; }.member { display:flex; align-items:center; justify-content:space-between; padding:22rpx 0; border-bottom:2rpx dashed #e5d5c8; }.member:last-child { border-bottom:0; }.member-name { font-weight:800; }.privacy { padding:20rpx; color:#8b7d74; text-align:center; font-size:23rpx; }
