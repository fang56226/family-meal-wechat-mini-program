<view class="page">
  <view class="hero"><view><view class="hero-title">做饭模式</view><view class="hero-subtitle">今天辛苦啦！</view><view class="streak">📅 今天也要好好吃饭</view></view><view class="hero-dog">👨🏻‍🍳</view></view>
  <view wx:if="{{loading}}" class="loading">正在读取饭单…</view>
  <view wx:elif="{{!allowed}}" class="card empty"><view class="empty-icon">🔒</view><view class="empty-title">等待加入家庭</view></view>
  <view wx:elif="{{!order}}" class="card empty"><line-dog size="124"></line-dog><view class="empty-title">还没有今天的饭单</view><view class="muted">点完菜后，饭单会出现在这里</view></view>
  <block wx:else>
    <view class="card">
      <view class="row between"><view class="title">本顿饭单</view><view class="status s{{order.status}}">{{order.statusText}}</view></view>
      <view class="ordered-dish" wx:for="{{order.items}}" wx:key="dishId">
        <image wx:if="{{item.imageFileID}}" src="{{item.displayImageURL || item.imageFileID}}" mode="aspectFill" />
        <view wx:else class="mini-emoji">{{item.emoji}}</view>
        <view class="order-info"><view class="row between"><text class="dish-name">{{item.name}}</text><text>× {{item.count}}</text></view><view class="muted">需要：{{item.ingredients}}</view><view wx:if="{{item.note}}" class="muted">备注：{{item.note}}</view></view>
      </view>
      <view class="muted order-meta">由 {{order.createdByName}} 点单</view>
    </view>

    <button wx:if="{{order.status === 0}}" class="btn green" bindtap="acceptOrder">我来做这顿饭</button>
    <view wx:if="{{order.status === 1}}" class="card finish-card">
      <view class="title">饭做好啦，留个纪念 📷</view>
      <view class="muted">至少上传 1 张，最多 9 张</view>
      <view class="photo-grid">
        <view wx:for="{{selectedPhotos}}" wx:key="*this" class="photo-wrap"><image class="photo" src="{{item}}" mode="aspectFill" /><view class="remove" data-index="{{index}}" bindtap="removePhoto">×</view></view>
        <view wx:if="{{selectedPhotos.length < 9}}" class="photo-add" bindtap="pickPhotos">＋</view>
      </view>
      <textarea class="textarea" value="{{memoryNote}}" bindinput="setNote" placeholder="写一句今天的纪念（可不填）" />
      <button class="btn" style="margin-top:24rpx" loading="{{submitting}}" bindtap="finishOrder">完成并记录这顿饭</button>
    </view>
  </block>
</view>
